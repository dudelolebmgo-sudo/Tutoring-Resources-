const FANB = ['for','and','nor','but','or','yet','so'];

/* ---------- Helpers ---------- */
const $ = (s, r=document) => r.querySelector(s);
const esc = s => s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function shuffle(a){ a=a.slice(); for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]];} return a; }
const pickOne = a => a[Math.floor(Math.random()*a.length)];

function parse(m){
  let html='', text='', stack=[], conj='', cjCount=0, inCj=false, top=0, hasDep=false, depFirst=false;
  for(const ch of m){
    if(ch==='{'){ if(stack.length===0) top++; stack.push('ind'); html+='<span class="ind">'; }
    else if(ch==='('){ if(!hasDep) depFirst = text.trim()===''; hasDep=true; stack.push('dep'); html+='<span class="dep">'; }
    else if(ch==='['){ const a=stack.includes('dep'); stack.push('cj'); inCj=true; cjCount++; html+=`<span class="cj ${a?'cj-a':'cj-f'}">`; }
    else if(ch==='}'||ch===')'||ch===']'){ if(stack.pop()==='cj') inCj=false; html+='</span>'; }
    else { text+=ch; html+=esc(ch); if(inCj && cjCount===1) conj+=ch; }
  }
  const type = hasDep ? (depFirst?'complex-first':'complex-second') : (top>=2?'compound':'simple');
  return {html, text, type, conj: conj.toLowerCase()};
}

function explain(p){
  const c = p.conj;
  switch(p.type){
    case 'compound': return `Two complete sentences joined by <b>${c}</b>, a FANBOYS word. The comma goes right before <b>${c}</b>.`;
    case 'complex-first': return `The AWUBIS clause (starting with <b>${c}</b>) comes first, so a comma separates it from the main clause.`;
    case 'complex-second': return `The main clause comes first and the AWUBIS clause (starting with <b>${c}</b>) comes second, so no comma is needed.`;
    default: return c
      ? `This is one complete sentence. Here <b>${c}</b> joins two parts of it (like two names or two actions), not two complete sentences, so no comma.`
      : `One subject and one verb make one complete thought. Nothing is being joined, so no comma.`;
  }
}

const LEGEND = `<div class="legend"><span><i class="lg"></i>main clause</span><span><i class="lg dep"></i>AWUBIS clause</span><span><mark class="cj cj-f">FANBOYS</mark></span><span><mark class="cj cj-a">AWUBIS</mark></span></div>`;
const diagram = p => `<div class="diagram">${p.html}</div>${LEGEND}`;
const RIGHT = ['Correct!','Nice work!','Exactly right.','You got it!'];
const WRONG = ['Not quite.','Almost.','Let’s fix that.'];
const fb = (ok, body, title) => `<div class="fb ${ok?'ok':'bad'}"><p class="verdict">${ok?'✓':'✗'} ${title || pickOne(ok?RIGHT:WRONG)}</p>${body}</div>`;

/* ---------- Answer checker for typed sentences ---------- */
function clean(s){
  return s.replace(/[’‘]/g,"'").replace(/[“”]/g,'"').replace(/\s+/g,' ').trim().replace(/\s+([,.!?])/g,'$1');
}
const loose = s => s.toLowerCase().replace(/[,.!?;:]/g,' ').replace(/\s+/g,' ').trim();
const bare = w => w.replace(/[,.!?;:]/g,'');

function commaMsg(p, missing, extra, sw){
  const c = p.conj;
  const after = i => `“${bare(sw[i])}”`;
  if(p.type==='compound'){
    if(missing.length && extra.length) return `Move the comma so it comes right before “${c}”, not after it.`;
    if(missing.length) return `Add a comma before “${c}”. When a FANBOYS word joins two complete sentences, a comma goes in front of it.`;
    return `Remove the extra comma. This sentence needs just one comma, right before “${c}”.`;
  }
  if(p.type==='complex-first'){
    if(missing.length && extra.length) return `Move the comma to the end of the AWUBIS clause, after ${after(missing[0])}.`;
    if(missing.length) return `The AWUBIS clause comes first, so put a comma at the end of it, after ${after(missing[0])}.`;
    return `Remove the extra comma. The only comma goes at the end of the AWUBIS clause.`;
  }
  if(p.type==='complex-second'){
    return `The AWUBIS clause (starting with “${c}”) comes second, so it doesn't need a comma.`;
  }
  return c ? `“${c}” joins two parts of one sentence here, not two complete sentences, so don't use a comma.` : `This sentence doesn't need a comma.`;
}

function diagnose(s, p){
  const issues=[], t=p.text;
  if(/[a-z]/.test(s[0])) issues.push('Start the sentence with a capital letter.');
  if(/[.!?]/.test(s.slice(0,-1))) issues.push('Use only one end mark, at the very end. Once two sentences are joined, they become one sentence.');
  const end=t.slice(-1);
  if(s.slice(-1)!==end) issues.push(end==='.' ? 'End the sentence with a period.' : `End the sentence with “${end}”.`);
  const sw=s.split(' '), tw=t.split(' ');
  if(sw.length===tw.length){
    const ci = arr => arr.map((w,i)=>/,$/.test(w.replace(/[.!?]+$/,''))||w.includes(',')?i:-1).filter(i=>i>=0);
    const sc=ci(sw), tc=ci(tw);
    const missing=tc.filter(i=>!sc.includes(i)), extra=sc.filter(i=>!tc.includes(i));
    if(missing.length||extra.length) issues.push(commaMsg(p, missing, extra, sw));
    let caseCount=0;
    for(let i=1;i<sw.length && caseCount<2;i++){
      const a=bare(sw[i]), b=bare(tw[i]);
      if(a!==b && a.toLowerCase()===b.toLowerCase()){
        caseCount++;
        if(b==='I') issues.push('The word “I” is always a capital letter.');
        else if(/^[A-Z]/.test(b)) issues.push(`“${a}” is a name, so it needs a capital letter.`);
        else issues.push(`“${a}” should be lowercase. Only the first word, names, and “I” get capitals.`);
      }
    }
  } else {
    issues.push('Check the spacing around your commas and periods.');
  }
  return issues;
}

function check(input, P, mismatch){
  const s=clean(input);
  if(!s) return {ok:false, issues:['Type your sentence first.']};
  for(const p of P) if(s===p.text) return {ok:true, p};
  const L=loose(s), cands=P.filter(p=>loose(p.text)===L);
  if(!cands.length) return {ok:false, issues:[mismatch(s)]};
  let best=null;
  for(const p of cands){ const iss=diagnose(s,p); if(!best||iss.length<best.length) best=iss; }
  if(!best.length) best=['Look closely at your punctuation and capitals.'];
  return {ok:false, issues:best};
}

/* ---------- Scores (kept in this browser only) ---------- */
const KEY='fanboys-awubis-workshop-v1';
let store={scores:{}, streak:0, best:0};
try{ const raw=localStorage.getItem(KEY); if(raw) store=Object.assign(store, JSON.parse(raw)); }catch(e){}
const save=()=>{ try{ localStorage.setItem(KEY, JSON.stringify(store)); }catch(e){} };

/* ---------- Activities ---------- */
const ACT = {
  comma:{name:'Comma Spot', bank:SENT, blurb:'Tap where the comma goes'},
  type: {name:'Name the Type', bank:SENT, blurb:'Simple, compound, or complex?'},
  join: {name:'Join It', bank:JOIN, blurb:'Combine two sentences'},
  fix:  {name:'Fix It', bank:FIX, blurb:'Correct the mistakes'},
  pick: {name:'Pick the Word', bank:PICK, blurb:'Choose the joining word'}
};
const ROUND=10;
const S={};
const TABS=[['learn','Learn'], ...Object.entries(ACT).map(([k,v])=>[k,v.name])];

function updateScores(){
  let c=0,t=0;
  for(const k in ACT){
    const sc=store.scores[k]||{c:0,t:0}; c+=sc.c; t+=sc.t;
    const b=$(`#badge-${k}`); if(b){ b.textContent = sc.t ? `${sc.c}/${sc.t}` : ''; b.hidden=!sc.t; }
  }
  $('#st-total').textContent=`${c} / ${t}`;
  $('#st-streak').textContent=store.streak;
  $('#st-best').textContent=store.best;
}

function result(key, ok){
  const s=S[key]; if(s.answered) return; s.answered=true;
  if(ok) s.right++;
  const sc = store.scores[key] || (store.scores[key]={c:0,t:0});
  sc.t++;
  if(ok){ sc.c++; store.streak++; store.best=Math.max(store.best, store.streak); } else store.streak=0;
  save(); updateScores();
}

function newRound(key){ S[key]={deck:shuffle(ACT[key].bank).slice(0,ROUND), i:0, right:0, answered:false}; render(key); }
function next(key){ const s=S[key]; s.i++; s.answered=false; render(key); }

function head(key){
  const s=S[key], n=s.deck.length;
  return `<div class="qhead"><span class="eyebrow">Question ${s.i+1} of ${n}</span><span class="tally">${s.right} right this round</span></div><div class="bar"><i style="width:${s.i/n*100}%"></i></div>`;
}

function showNext(key, panel){
  const a=$('.actions', panel);
  a.innerHTML=`<button class="btn primary" id="${key}-next">${S[key].i+1<S[key].deck.length?'Next question →':'See my score →'}</button>`;
  const b=$(`#${key}-next`); b.onclick=()=>next(key); b.focus({preventScroll:true});
}

function render(key){
  const panel=$('#p-'+key), s=S[key];
  if(s.i>=s.deck.length){
    const n=s.deck.length, pct=s.right/n;
    const msg = pct>=.9 ? 'Excellent work. These rules are sticking.' : pct>=.7 ? 'Solid round. One more will lock it in.' : 'Look back at the Learn tab, then try again. Each round gets easier.';
    panel.innerHTML=`<div class="card done"><p class="eyebrow">${ACT[key].name} · round complete</p><p class="big">${s.right} / ${n}</p><p>${msg}</p><div class="actions"><button class="btn primary" id="${key}-again">Play another round</button><button class="btn" data-goto="learn">Review the rules</button></div></div>`;
    $(`#${key}-again`, panel).onclick=()=>newRound(key);
    $('[data-goto]', panel).onclick=()=>show('learn');
    return;
  }
  ({comma:renderComma, type:renderType, join:renderJoin, fix:renderFix, pick:renderPick})[key](key, panel, s.deck[s.i]);
}

/* Comma Spot */
function renderComma(key, panel, item){
  const p=parse(item), raw=p.text.split(' ');
  const words=raw.map(w=>w.replace(/,$/,''));
  const target=raw.map((w,i)=>w.endsWith(',')?i:-1).filter(i=>i>=0);
  let row='';
  words.forEach((w,i)=>{
    row+=`<span class="w">${esc(w)}</span>`;
    if(i<words.length-1) row+=`<button class="gap" data-i="${i}" aria-pressed="false" aria-label="Comma after ${esc(w)}"><span>,</span></button>`;
  });
  panel.innerHTML = head(key)+`<div class="card">
    <p class="prompt">Tap the space where a comma belongs. If the sentence needs no comma, just press Check.</p>
    <div class="cwords">${row}</div>
    <p class="hintline">Tap a space again to remove a comma.</p>
    <div class="actions"><button class="btn primary" id="comma-go">Check</button></div>
    <div class="fbslot" aria-live="polite"></div></div>`;
  panel.querySelectorAll('.gap').forEach(g=>g.onclick=()=>{ const on=g.classList.toggle('on'); g.setAttribute('aria-pressed', on); });
  $('#comma-go').onclick=()=>{
    const placed=[...panel.querySelectorAll('.gap.on')].map(g=>+g.dataset.i);
    const ok = placed.length===target.length && placed.every(i=>target.includes(i));
    panel.querySelectorAll('.gap').forEach(g=>{
      const i=+g.dataset.i, on=g.classList.contains('on'), want=target.includes(i);
      g.disabled=true; g.classList.remove('on');
      if(on&&want) g.classList.add('hit'); else if(on&&!want) g.classList.add('wrong'); else if(!on&&want) g.classList.add('miss');
    });
    result(key, ok);
    const extra = ok ? '' : `<p>${target.length?'Green shows where the comma belongs. ':''}${placed.some(i=>!target.includes(i))?'Red commas don’t belong.':''}</p>`;
    $('.fbslot',panel).innerHTML = fb(ok, `${extra}${diagram(p)}<p class="why">${explain(p)}</p>`);
    showNext(key, panel);
  };
}

/* Name the Type */
function renderType(key, panel, item){
  const p=parse(item);
  const kind = p.type.startsWith('complex') ? 'complex' : p.type;
  const label = {simple:'simple', compound:'compound', complex:'complex'};
  panel.innerHTML = head(key)+`<div class="card">
    <p class="prompt">What kind of sentence is this?</p>
    <p class="sentence">${esc(p.text)}</p>
    <div class="choices">
      <button class="choice" data-v="simple">Simple<small>one complete thought</small></button>
      <button class="choice" data-v="compound">Compound<small>FANBOYS joins two sentences</small></button>
      <button class="choice" data-v="complex">Complex<small>has an AWUBIS clause</small></button>
    </div>
    <div class="actions"></div>
    <div class="fbslot" aria-live="polite"></div></div>`;
  panel.querySelectorAll('.choice').forEach(b=>b.onclick=()=>{
    const ok=b.dataset.v===kind;
    panel.querySelectorAll('.choice').forEach(x=>{ x.disabled=true; if(x.dataset.v===kind) x.classList.add('right'); });
    if(!ok) b.classList.add('wrong');
    result(key, ok);
    $('.fbslot',panel).innerHTML = fb(ok, `<p>This is a <b>${label[kind]}</b> sentence.</p>${diagram(p)}<p class="why">${explain(p)}</p>`);
    showNext(key, panel);
  });
}

/* Shared typed-answer flow for Join It and Fix It */
function typedFlow(key, panel, P, mismatch){
  const input=$(`#${key}-in`), slot=$('.fbslot',panel), actions=$('.actions',panel);
  const reveal=()=>{
    result(key,false);
    input.disabled=true;
    const others=P.slice(1).map(p=>`<i>${esc(p.text)}</i>`).join(' or ');
    slot.innerHTML = fb(false, `<p>A correct answer:</p>${diagram(P[0])}<p class="why">${explain(P[0])}</p>${others?`<p class="also">Also correct: ${others}</p>`:''}`, 'Here’s the answer.');
    showNext(key, panel);
  };
  const go=()=>{
    const r=check(input.value, P, mismatch);
    if(r.ok){
      result(key,true);
      input.disabled=true;
      const others=P.filter(p=>p!==r.p).map(p=>`<i>${esc(p.text)}</i>`).join(' or ');
      slot.innerHTML = fb(true, `${diagram(r.p)}<p class="why">${explain(r.p)}</p>${others?`<p class="also">Also correct: ${others}</p>`:''}`);
      showNext(key, panel);
    } else {
      if(r.issues[0]!=='Type your sentence first.') result(key,false);
      slot.innerHTML = fb(false, `<ul class="issues">${r.issues.map(i=>`<li>${i}</li>`).join('')}</ul><p class="muted">Fix it and press Check again.</p>`);
      if(!$(`#${key}-show`)){
        actions.insertAdjacentHTML('beforeend', `<button class="btn" id="${key}-show">Show answer</button>`);
        $(`#${key}-show`).onclick=reveal;
      }
      input.focus({preventScroll:true});
    }
  };
  $(`#${key}-go`).onclick=go;
  input.addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); go(); } });
}

const inputAttrs = `autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"`;

/* Join It */
function renderJoin(key, panel, item){
  const P=item.ans.map(parse), isF=FANB.includes(item.w);
  panel.innerHTML = head(key)+`<div class="card">
    <p class="prompt">${isF
      ? `Join these into one <b>compound</b> sentence using the FANBOYS word below.`
      : `Join these into one <b>complex</b> sentence using the AWUBIS word below. Its clause can go first or second.`}</p>
    <div class="given"><div><em>1</em><span>${esc(item.a)}</span></div><div><em>2</em><span>${esc(item.b)}</span></div></div>
    <div class="joinword">Joining word <mark class="cj ${isF?'cj-f':'cj-a'}">${item.w}</mark></div>
    <label class="eyebrow" for="join-in">Your sentence</label>
    <input class="answer" id="join-in" type="text" ${inputAttrs} placeholder="Type the new sentence">
    <div class="actions"><button class="btn primary" id="join-go">Check</button></div>
    <div class="fbslot" aria-live="polite"></div></div>`;
  typedFlow(key, panel, P, s => {
    if(!new RegExp(`\\b${item.w}\\b`,'i').test(s)) return `Use the joining word “${item.w}”.`;
    return isF
      ? `The words don’t match yet. Keep both sentences in order, with “${item.w}” between them, and check your spelling.`
      : `The words don’t match yet. Put “${item.w}” in front of the idea it explains, keep all the other words, and check your spelling.`;
  });
  $('#join-in').focus({preventScroll:true});
}

/* Fix It */
function renderFix(key, panel, item){
  const P=item.ans.map(parse);
  panel.innerHTML = head(key)+`<div class="card">
    <p class="prompt">This sentence has <b>${item.n} mistake${item.n>1?'s':''}</b>. Fix ${item.n>1?'them':'it'} in the box below.</p>
    <div class="draft">${esc(item.bad)}</div>
    <label class="eyebrow" for="fix-in">Corrected sentence</label>
    <input class="answer" id="fix-in" type="text" ${inputAttrs} value="${esc(item.bad)}">
    <div class="actions"><button class="btn primary" id="fix-go">Check</button></div>
    <div class="fbslot" aria-live="polite"></div></div>`;
  typedFlow(key, panel, P, () => item.hint || 'Some words changed. Keep the original words and fix only the capitals, commas, and periods.');
}

/* Pick the Word */
function renderPick(key, panel, item){
  const p=parse(item.m);
  const blank=parse(item.m.replace(/\[[^\]]*\]/, '[___]')).text.split('___');
  panel.innerHTML = head(key)+`<div class="card">
    <p class="prompt">Which joining word makes the most sense?</p>
    <p class="sentence">${esc(blank[0])}<span class="blank"></span>${esc(blank[1])}</p>
    <div class="choices">${shuffle(item.opts).map(o=>`<button class="choice" data-v="${o}">${o}</button>`).join('')}</div>
    <div class="actions"></div>
    <div class="fbslot" aria-live="polite"></div></div>`;
  panel.querySelectorAll('.choice').forEach(b=>b.onclick=()=>{
    const ok=item.ok.includes(b.dataset.v);
    panel.querySelectorAll('.choice').forEach(x=>{ x.disabled=true; if(item.ok.includes(x.dataset.v)) x.classList.add('right'); });
    if(!ok) b.classList.add('wrong');
    result(key, ok);
    $('.fbslot',panel).innerHTML = fb(ok, `${diagram(p)}<p class="why">${item.why} ${explain(p)}</p>`);
    showNext(key, panel);
  });
}

/* ---------- Tabs ---------- */
function show(key){
  TABS.forEach(([k])=>{
    $(`#tab-${k}`).setAttribute('aria-selected', k===key);
    $(`#p-${k}`).hidden = k!==key;
  });
  if(ACT[key] && !S[key]) newRound(key);
  try{ history.replaceState(null,'', key==='learn' ? location.pathname+location.search : '#'+key); }catch(e){}
}

$('#tabs').innerHTML = TABS.map(([k,n])=>`<button class="tab" role="tab" id="tab-${k}" aria-controls="p-${k}" aria-selected="false">${n}${ACT[k]?` <span class="badge" id="badge-${k}" hidden></span>`:''}</button>`).join('');
TABS.forEach(([k])=>{ $(`#tab-${k}`).onclick=()=>show(k); });

$('#ctas').innerHTML = Object.entries(ACT).map(([k,v])=>`<button class="btn ${k==='comma'?'primary':''}" data-k="${k}">${v.name}</button>`).join('');
$('#ctas').querySelectorAll('button').forEach(b=>b.onclick=()=>{ show(b.dataset.k); window.scrollTo({top:0, behavior:'smooth'}); });

document.querySelectorAll('.ex[data-m]').forEach(el=>{ el.innerHTML=parse(el.dataset.m).html; });
$('#legend-learn').outerHTML = LEGEND;

/* reset with in-page confirm */
function bindReset(){
  $('#reset').onclick=()=>{
    $('#reset-zone').innerHTML=`<span class="confirm">Reset all scores? <button class="btn small" id="reset-yes">Reset</button><button class="btn small" id="reset-no">Cancel</button></span>`;
    $('#reset-yes').onclick=()=>{ store={scores:{}, streak:0, best:0}; save(); updateScores(); restore(); };
    $('#reset-no').onclick=restore;
  };
}
function restore(){ $('#reset-zone').innerHTML=`<button class="linkbtn" id="reset">Reset scores</button>`; bindReset(); }
bindReset();

updateScores();
const start = location.hash.replace('#','');
show(ACT[start] ? start : 'learn');
</script>
