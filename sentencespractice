<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Practice compound (FANBOYS) and complex (AWUBIS) sentences, commas, capitals and end marks.">
<title>FANBOYS & AWUBIS Workshop</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Lexend:wght@400;500;600&family=Shantell+Sans:wght@500;700&display=swap">
<style>
/* Layout: a ruled-notebook header with a red margin line, then one centered working column with tabbed activities. */
:root{
  --paper:#F3F6FB; --surface:#FFFFFF; --ink:#18213A; --muted:#58637D; --line:#D7DEEB; --rule:#C9D6EE; --margin:#E06A63;
  --accent:#2B5BD7; --accent-ink:#FFFFFF;
  --ind:#2B5BD7; --dep:#C2367F;
  --fan-bg:#FFE45C; --awu-bg:#FFB8DC; --hl-ink:#18213A;
  --ok:#167A45; --ok-bg:#E4F4EA; --bad:#C8302A; --bad-bg:#FCECEA;
  --f-display:"Young Serif", Georgia, "Times New Roman", serif;
  --f-body:"Lexend", system-ui, -apple-system, "Segoe UI", sans-serif;
  --f-hand:"Shantell Sans", "Comic Sans MS", "Chalkboard SE", cursive;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#10151F; --surface:#18202E; --ink:#E6EBF5; --muted:#9AA6BF; --line:#2B3547; --rule:#222C3D; --margin:#B5524C;
    --accent:#86A8FF; --accent-ink:#0E1424; --ind:#86A8FF; --dep:#FF8CC6;
    --fan-bg:rgba(255,220,70,.34); --awu-bg:rgba(255,120,190,.32); --hl-ink:#F4F6FB;
    --ok:#62D394; --ok-bg:rgba(98,211,148,.12); --bad:#FF7D73; --bad-bg:rgba(255,125,115,.12);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --paper:#10151F; --surface:#18202E; --ink:#E6EBF5; --muted:#9AA6BF; --line:#2B3547; --rule:#222C3D; --margin:#B5524C;
  --accent:#86A8FF; --accent-ink:#0E1424; --ind:#86A8FF; --dep:#FF8CC6;
  --fan-bg:rgba(255,220,70,.34); --awu-bg:rgba(255,120,190,.32); --hl-ink:#F4F6FB;
  --ok:#62D394; --ok-bg:rgba(98,211,148,.12); --bad:#FF7D73; --bad-bg:rgba(255,125,115,.12);
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--paper);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.55}
.wrap{max-width:820px;margin:0 auto;padding-left:max(16px, env(safe-area-inset-left, 0px));padding-right:max(16px, env(safe-area-inset-right, 0px));padding-block:24px 64px}

/* notebook header */
.sheet{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:hidden;
  background-image:repeating-linear-gradient(to bottom, transparent 0, transparent 31px, var(--rule) 31px, var(--rule) 32px);
  padding:28px 22px 22px 58px}
.sheet::before{content:"";position:absolute;top:0;bottom:0;left:40px;width:2px;background:var(--margin);opacity:.7}
.eyebrow{font-size:.75rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
h1{font-family:var(--f-display);font-weight:400;font-size:clamp(1.8rem, 5.5vw, 2.6rem);line-height:1.15;margin:6px 0 8px;text-wrap:balance}
h1 .f{background:var(--fan-bg);color:var(--hl-ink);padding:0 .12em;border-radius:4px}
h1 .a{background:var(--awu-bg);color:var(--hl-ink);padding:0 .12em;border-radius:4px}
.lede{margin:0;max-width:56ch;color:var(--muted)}
.stats{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:18px;align-items:baseline;font-variant-numeric:tabular-nums}
.stat b{font-size:1.25rem;font-weight:600;color:var(--ink)}
.stat span{color:var(--muted);font-size:.85rem;margin-left:4px}
.linkbtn{background:none;border:none;color:var(--muted);font:500 .85rem var(--f-body);text-decoration:underline;cursor:pointer;padding:4px 0}
.confirm{display:inline-flex;gap:8px;align-items:center;font-size:.85rem}

/* tabs */
.tabs-scroll{overflow-x:auto;margin-top:20px;border-bottom:1px solid var(--line);scrollbar-width:thin}
.tabs{display:flex;gap:2px;min-width:max-content}
.tab{padding:10px 12px 9px;border:none;background:none;font:500 .95rem var(--f-body);color:var(--muted);border-bottom:3px solid transparent;white-space:nowrap;cursor:pointer;display:flex;gap:6px;align-items:center}
.tab:hover{color:var(--ink)}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
.badge{font-size:.72rem;font-variant-numeric:tabular-nums;color:var(--muted);background:var(--paper);border:1px solid var(--line);border-radius:99px;padding:0 7px}
.panel{padding-top:20px}

.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:22px}
.stack{display:grid;gap:16px}
h2{font-family:var(--f-display);font-weight:400;font-size:1.5rem;margin:0 0 6px;text-wrap:balance}
h3{font-size:1rem;font-weight:600;margin:18px 0 8px}
p{margin:0 0 10px}
.muted{color:var(--muted)}

/* clause marks */
.ind{text-decoration:underline solid var(--ind) 3px;text-underline-offset:7px;text-decoration-skip-ink:none}
.dep{text-decoration:underline dashed var(--dep) 3px;text-underline-offset:7px;text-decoration-skip-ink:none}
.cj{border-radius:4px;padding:0 .14em;color:var(--hl-ink);font-weight:600}
.cj-f{background:var(--fan-bg)}
.cj-a{background:var(--awu-bg)}
mark.cj{font-weight:600}
.diagram{font-size:clamp(1.1rem, 3.4vw, 1.35rem);line-height:2.1;margin:6px 0 4px}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:.78rem;color:var(--muted);align-items:center;margin-top:6px}
.legend span{display:inline-flex;align-items:center;gap:6px}
.lg{display:inline-block;width:22px;height:0;border-bottom:3px solid var(--ind)}
.lg.dep{border-bottom:3px dashed var(--dep);text-decoration:none}

/* learn */
.formula{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:10px 0 14px}
.slot{border-radius:8px;padding:5px 10px;font-size:.88rem;font-weight:500;border:1.5px solid var(--line);background:var(--paper)}
.slot.i{border-color:var(--ind);border-style:solid}
.slot.d{border-color:var(--dep);border-style:dashed}
.slot.f{background:var(--fan-bg);color:var(--hl-ink);border-color:transparent;font-weight:600}
.slot.a{background:var(--awu-bg);color:var(--hl-ink);border-color:transparent;font-weight:600}
.punct{font:700 1.5rem var(--f-hand);color:var(--bad);line-height:1}
.nocomma{font:500 .8rem var(--f-hand);color:var(--muted)}
.letters{display:grid;grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));gap:8px;margin:10px 0 14px}
.letter{border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--paper)}
.letter .L{font-family:var(--f-display);font-size:1.5rem;line-height:1}
.letter .wd{font-weight:600;margin-top:4px}
.letter .mn{font-size:.82rem;color:var(--muted);line-height:1.35}
.ex{font-size:1.1rem;line-height:2.1;margin:2px 0}
.traps{display:grid;gap:12px}
.trap{border-top:1px solid var(--line);padding-top:12px}
.trap:first-child{border-top:none;padding-top:0}
.trap .t{font-weight:600;margin-bottom:4px}
.wrongline{font-family:var(--f-hand);color:var(--bad)}
.wrongline s{text-decoration-thickness:2px}
.rightline{color:var(--ok);font-weight:500}
.ctas{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}

/* practice */
.qhead{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:8px;font-variant-numeric:tabular-nums}
.tally{font-size:.85rem;color:var(--muted)}
.bar{height:6px;border-radius:99px;background:var(--line);overflow:hidden;margin-bottom:14px}
.bar i{display:block;height:100%;background:var(--accent);transition:width .3s}
.prompt{font-weight:500;margin-bottom:14px}
.sentence{font-size:clamp(1.25rem, 3.8vw, 1.6rem);line-height:1.6;margin:4px 0 18px}
.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.btn{font:600 1rem var(--f-body);padding:11px 18px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}
.btn:hover{border-color:var(--muted)}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn.small{padding:7px 12px;font-size:.88rem}
button:focus-visible,input:focus-visible{outline:3px solid var(--accent);outline-offset:2px}

.cwords{display:flex;flex-wrap:wrap;align-items:flex-end;font-size:clamp(1.25rem, 3.8vw, 1.6rem);line-height:1.5;row-gap:6px;margin:4px 0 6px}
.w{padding:0 1px}
.gap{position:relative;display:inline-flex;align-items:flex-end;justify-content:center;width:22px;height:2.1em;margin:0;border:none;background:transparent;border-radius:6px;cursor:pointer;padding:0 0 2px;color:var(--bad);font:700 1.15em var(--f-hand)}
.gap::after{content:"";position:absolute;left:50%;bottom:4px;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:var(--line)}
.gap:hover{background:var(--paper)}
.gap span{opacity:0;line-height:1;transform:translateX(-3px)}
.gap.on span{opacity:1}
.gap.on::after,.gap.hit::after,.gap.miss::after,.gap.wrong::after{display:none}
.gap:disabled{cursor:default}
.gap.hit span{opacity:1;color:var(--ok)}
.gap.miss{background:var(--ok-bg)}
.gap.miss span{opacity:1;color:var(--ok)}
.gap.wrong{background:var(--bad-bg)}
.gap.wrong span{opacity:1;color:var(--bad)}
.hintline{font-size:.82rem;color:var(--muted)}

.choices{display:grid;grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));gap:8px}
.choice{text-align:left;font:600 1.05rem var(--f-body);padding:12px 14px;border-radius:10px;border:1.5px solid var(--line);background:var(--paper);color:var(--ink);cursor:pointer}
.choice small{display:block;font-weight:400;font-size:.8rem;color:var(--muted);margin-top:2px}
.choice:hover:not(:disabled){border-color:var(--accent)}
.choice:disabled{cursor:default}
.choice.right{border-color:var(--ok);background:var(--ok-bg)}
.choice.wrong{border-color:var(--bad);background:var(--bad-bg)}
.blank{display:inline-block;min-width:4.2em;border-bottom:3px solid var(--accent);margin:0 .15em;height:1.1em;vertical-align:-.15em}

.given{display:grid;gap:8px;margin-bottom:14px}
.given div{display:flex;gap:10px;align-items:baseline;font-size:1.15rem}
.given em{font-style:normal;font-size:.75rem;font-weight:600;color:var(--muted);min-width:1.4em}
.joinword{display:flex;align-items:center;gap:10px;font-size:.9rem;color:var(--muted);margin-bottom:14px}
.joinword mark{font-size:1.1rem}
.draft{font-size:1.15rem;padding:12px 14px;border:1px dashed var(--bad);border-radius:10px;margin-bottom:14px}
.answer{width:100%;font:1.15rem var(--f-body);padding:12px 14px;border:2px solid var(--line);border-radius:10px;background:var(--paper);color:var(--ink)}
.answer:focus{border-color:var(--accent);outline:none}

.fb{margin-top:18px;padding:16px 18px;border-radius:12px}
.fb.ok{background:var(--ok-bg)}
.fb.bad{background:var(--bad-bg)}
.verdict{font:700 1.3rem var(--f-hand);margin:0 0 6px}
.fb.ok .verdict{color:var(--ok)}
.fb.bad .verdict{color:var(--bad)}
.issues{margin:0 0 6px;padding-left:1.2em;font-family:var(--f-hand);font-weight:500;color:var(--bad);font-size:1.02rem}
.issues li{margin-bottom:4px}
.why{margin-top:8px}
.also{font-size:.9rem;color:var(--muted);margin-top:8px}

.done{text-align:left}
.big{font-family:var(--f-display);font-size:3rem;line-height:1;margin:8px 0 10px;font-variant-numeric:tabular-nums}
@media (prefers-reduced-motion: reduce){ .bar i{transition:none} }
@media (max-width:480px){ .sheet{padding-left:44px} .sheet::before{left:28px} .card{padding:18px} }

/* base reset (normally supplied by the artifact host) */
html{color-scheme:light}
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{margin:0}
img{max-width:100%}
[hidden]{display:none!important}
</style>
</head>
<body>
<div class="wrap">
  <header class="sheet">
    <div class="eyebrow">Sentence practice</div>
    <h1><span class="f">FANBOYS</span> &amp; <span class="a">AWUBIS</span> Workshop</h1>
    <p class="lede">Join sentences, place commas, and check capitals and end marks. Every answer shows you the clauses so you can see why it works.</p>
    <div class="stats">
      <div class="stat"><b id="st-total">0 / 0</b><span>correct on first try</span></div>
      <div class="stat"><b id="st-streak">0</b><span>in a row</span></div>
      <div class="stat"><b id="st-best">0</b><span>best streak</span></div>
      <div id="reset-zone"><button class="linkbtn" id="reset">Reset scores</button></div>
    </div>
  </header>

  <div class="tabs-scroll">
    <div class="tabs" role="tablist" id="tabs"></div>
  </div>

  <section class="panel" id="p-learn" role="tabpanel">
    <div class="stack">
      <div class="card">
        <h2>Every sentence follows three rules</h2>
        <p>1. It starts with a <b>capital letter</b>. &nbsp;2. It ends with a <b>period, question mark, or exclamation point</b>. &nbsp;3. It is a <b>complete thought</b>: it has a subject (who or what) and a verb (what they do or are).</p>
        <p class="muted">A group of words that can stand alone as a sentence is called an <b>independent clause</b> (a main clause). The underlines below always show clauses:</p>
        <div class="legend" id="legend-learn"></div>
      </div>

      <div class="card">
        <h2>Compound sentences use FANBOYS</h2>
        <p>Join two complete sentences with a FANBOYS word. Put a <b>comma before</b> the FANBOYS word.</p>
        <div class="formula">
          <span class="slot i">complete sentence</span><span class="punct">,</span><span class="slot f">FANBOYS</span><span class="slot i">complete sentence</span><span class="punct">.</span>
        </div>
        <div class="letters">
          <div class="letter"><div class="L">F</div><div class="wd">for</div><div class="mn">means "because" (formal)</div></div>
          <div class="letter"><div class="L">A</div><div class="wd">and</div><div class="mn">adds more</div></div>
          <div class="letter"><div class="L">N</div><div class="wd">nor</div><div class="mn">adds another "not"</div></div>
          <div class="letter"><div class="L">B</div><div class="wd">but</div><div class="mn">shows a contrast</div></div>
          <div class="letter"><div class="L">O</div><div class="wd">or</div><div class="mn">gives a choice</div></div>
          <div class="letter"><div class="L">Y</div><div class="wd">yet</div><div class="mn">surprising contrast</div></div>
          <div class="letter"><div class="L">S</div><div class="wd">so</div><div class="mn">shows a result</div></div>
        </div>
        <p class="ex" data-m="{I wanted to play outside}, [but] {it started to rain}."></p>
        <p class="ex" data-m="{The roads were icy}, [so] {school was canceled}."></p>
      </div>

      <div class="card">
        <h2>Complex sentences use AWUBIS</h2>
        <p>An AWUBIS word starts a <b>dependent clause</b>. It has a subject and verb, but it can't stand alone. Attach it to a complete sentence.</p>
        <h3>AWUBIS clause first: use a comma</h3>
        <div class="formula">
          <span class="slot a">AWUBIS</span><span class="slot d">rest of the clause</span><span class="punct">,</span><span class="slot i">complete sentence</span><span class="punct">.</span>
        </div>
        <p class="ex" data-m="([Because] it was cold), {I wore my thick jacket}."></p>
        <h3>AWUBIS clause second: no comma</h3>
        <div class="formula">
          <span class="slot i">complete sentence</span><span class="nocomma">no comma</span><span class="slot a">AWUBIS</span><span class="slot d">rest of the clause</span><span class="punct">.</span>
        </div>
        <p class="ex" data-m="{I wore my thick jacket} ([because] it was cold)."></p>
        <div class="letters">
          <div class="letter"><div class="L">A</div><div class="wd">as, after, although</div><div class="mn">time, order, surprise</div></div>
          <div class="letter"><div class="L">W</div><div class="wd">when, while</div><div class="mn">time</div></div>
          <div class="letter"><div class="L">U</div><div class="wd">until, unless</div><div class="mn">up to a time, condition</div></div>
          <div class="letter"><div class="L">B</div><div class="wd">because, before</div><div class="mn">reason, order</div></div>
          <div class="letter"><div class="L">I</div><div class="wd">if</div><div class="mn">condition</div></div>
          <div class="letter"><div class="L">S</div><div class="wd">since</div><div class="mn">reason or time</div></div>
        </div>
      </div>

      <div class="card">
        <h2>Watch out for these</h2>
        <div class="traps">
          <div class="trap">
            <div class="t">A comma alone can't join two sentences.</div>
            <div class="wrongline">✗ <s>I was tired, I went to bed.</s></div>
            <div class="rightline">✓ I was tired, so I went to bed.</div>
          </div>
          <div class="trap">
            <div class="t">No comma when FANBOYS joins only two actions or two names.</div>
            <p class="muted">Test it: cover everything before the FANBOYS word. If the part after it can't stand alone, don't use a comma.</p>
            <div class="wrongline">✗ <s>She grabbed her bag, and ran to the bus.</s></div>
            <div class="rightline">✓ She grabbed her bag and ran to the bus.</div>
          </div>
          <div class="trap">
            <div class="t">An AWUBIS clause by itself is a fragment.</div>
            <div class="wrongline">✗ <s>Because it was raining.</s></div>
            <div class="rightline">✓ We stayed inside because it was raining.</div>
          </div>
          <div class="trap">
            <div class="t">When you join two sentences, they become one.</div>
            <p class="muted">Remove the first period, and make the first letter of the second part lowercase (unless it's a name or "I").</p>
            <div class="wrongline">✗ <s>Dad made pancakes, and Then we ate.</s></div>
            <div class="rightline">✓ Dad made pancakes, and then we ate.</div>
          </div>
        </div>
      </div>

      <div class="card">
        <h2>Ready to practice?</h2>
        <p class="muted">Each round has 10 questions. Only your first try counts toward your score, but you can keep fixing typed answers until they're right.</p>
        <div class="ctas" id="ctas"></div>
      </div>
    </div>
  </section>

  <section class="panel" id="p-comma" role="tabpanel" hidden></section>
  <section class="panel" id="p-type" role="tabpanel" hidden></section>
  <section class="panel" id="p-join" role="tabpanel" hidden></section>
  <section class="panel" id="p-fix" role="tabpanel" hidden></section>
  <section class="panel" id="p-pick" role="tabpanel" hidden></section>
</div>

<script>
/* ---------- Content ----------
   Markup: {main clause}  (AWUBIS clause)  [joining word]  */
const SENT = [
  `{I wanted to play outside}, [but] {it started to rain}.`,
  `{My dog loves the park}, [so] {we go there every Saturday}.`,
  `{You can have pizza}, [or] {you can have tacos}.`,
  `{The test was hard}, [yet] {everyone passed it}.`,
  `{She opened the window}, [for] {the room was too hot}.`,
  `{Leo doesn't like spinach}, [nor] {does he like peas}.`,
  `{The bus was late}, [and] {we missed the first class}.`,
  `{Our team practiced every day}, [so] {we won the championship}.`,
  `([When] the bell rang), {the students ran outside}.`,
  `([Because] it was cold), {I wore my thick jacket}.`,
  `([If] you finish your homework), {you can watch a movie}.`,
  `([Although] the movie was long), {nobody fell asleep}.`,
  `([After] we ate dinner), {we played a board game}.`,
  `([Since] the library was closed), {we studied at home}.`,
  `([While] Mom cooked dinner), {I set the table}.`,
  `([Until] the rain stops), {we will stay inside}.`,
  `{I wore my thick jacket} ([because] it was cold).`,
  `{We will stay inside} ([until] the rain stops).`,
  `{The students ran outside} ([when] the bell rang).`,
  `{You can watch a movie} ([if] you finish your homework).`,
  `{Brush your teeth} ([before] you go to bed).`,
  `{The baby smiled} ([as] her dad sang to her).`,
  `{My sister has been happy} ([since] she got her puppy).`,
  `{Maria [and] her brother walked to school}.`,
  `{She finished her homework [and] went to bed}.`,
  `{We can play soccer [or] basketball}.`,
  `{The small brown dog barked at the mailman}.`
];

const JOIN = [
  {a:`I studied hard.`, b:`I passed the test.`, w:`so`, ans:[`{I studied hard}, [so] {I passed the test}.`]},
  {a:`Ana likes cats.`, b:`Her brother likes dogs.`, w:`but`, ans:[`{Ana likes cats}, [but] {her brother likes dogs}.`]},
  {a:`We can walk to the store.`, b:`We can ride our bikes.`, w:`or`, ans:[`{We can walk to the store}, [or] {we can ride our bikes}.`]},
  {a:`It was raining.`, b:`We played outside.`, w:`yet`, ans:[`{It was raining}, [yet] {we played outside}.`]},
  {a:`The baby was tired.`, b:`She took a nap.`, w:`so`, ans:[`{The baby was tired}, [so] {she took a nap}.`]},
  {a:`Dad made pancakes.`, b:`Mom made eggs.`, w:`and`, ans:[`{Dad made pancakes}, [and] {Mom made eggs}.`]},
  {a:`I was hungry.`, b:`I ate an apple.`, w:`because`, ans:[`{I ate an apple} ([because] I was hungry).`, `([Because] I was hungry), {I ate an apple}.`]},
  {a:`The bell rang.`, b:`We ran outside.`, w:`when`, ans:[`([When] the bell rang), {we ran outside}.`, `{We ran outside} ([when] the bell rang).`]},
  {a:`You finish your chores.`, b:`You can go to the party.`, w:`if`, ans:[`([If] you finish your chores), {you can go to the party}.`, `{You can go to the party} ([if] you finish your chores).`]},
